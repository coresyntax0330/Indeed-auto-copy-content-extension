{
  "manifest_version": 3,
  "name": "Indeed Content Copier",
  "version": "1.7.3",
  "description": "Generate and download tailored resumes from supported job sites",
  "permissions": ["clipboardWrite", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.cv-library.co/*",
        "https://*.cv-library.co.uk/*",
        "https://*.adzuna.com.au/*",
        "https://*.adzuna.at/*",
        "https://*.adzuna.be/*",
        "https://*.adzuna.com.br/*",
        "https://*.adzuna.ca/*",
        "https://*.adzuna.fr/*",
        "https://*.adzuna.de/*",
        "https://*.adzuna.in/*",
        "https://*.adzuna.it/*",
        "https://*.adzuna.com.mx/*",
        "https://*.adzuna.nl/*",
        "https://*.adzuna.co.nz/*",
        "https://*.adzuna.pl/*",
        "https://*.adzuna.sg/*",
        "https://*.adzuna.co.za/*",
        "https://*.adzuna.es/*",
        "https://*.adzuna.ch/*",
        "https://*.adzuna.co.uk/*",
        "https://*.adzuna.com/*",
        "https://*.reed.co.uk/*",
        "https://*.reed.com/*",
        "https://*.totaljobs.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "host_permissions": ["https://api.lovapextech.com/*"]
}
